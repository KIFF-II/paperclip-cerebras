{
  "name": "paperclip-adapter-cerebras",
  "version": "0.1.0",
  "description": "Paperclip external adapter that runs agents on Cerebras Inference through OpenCode.",
  "keywords": [
    "cerebras",
    "opencode",
    "paperclip",
    "paperclip-adapter"
  ],
  "homepage": "https://github.com/ProbablePrime/paperclip-cerebras#readme",
  "bugs": {
    "url": "https://github.com/ProbablePrime/paperclip-cerebras/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProbablePrime/paperclip-cerebras.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./ui-parser": "./dist/ui-parser.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@paperclipai/adapter-opencode-local": "2026.1023.0",
    "@paperclipai/adapter-utils": "2026.1023.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  }
}
